rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    
    // Chat media uploads - allow authenticated users to upload their own files
    match /chat-media/{userId}/{fileName} {
      allow read: if true; // Anyone can view uploaded media
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to upload to their own directories
    match /user-uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
